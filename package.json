{
  "name": "find-github-tool",
  "version": "0.1.0",
  "description": "Find the right open-source tool, app or library for any need, in plain language. MCP server + AI skill for Claude, Antigravity, Cursor, VS Code, Codex and more.",
  "type": "module",
  "license": "MIT",
  "author": "Aditya",
  "bin": {
    "find-github-tool": "dist/find-github-tool.mjs"
  },
  "files": [
    "dist",
    "skills",
    "adapters",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "serve": "node dist/find-github-tool.mjs serve",
    "pack:mcpb": "node scripts/pack-mcpb.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "claude",
    "antigravity",
    "github",
    "open-source",
    "alternatives",
    "self-hosted",
    "skill"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
